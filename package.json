{
  "name": "runbook-vscode",
  "displayName": "Runbook",
  "description": "VS Code bridge for the Runbook control surface (Claude Code agent loop)",
  "version": "0.1.0",
  "publisher": "runbook-rs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Runbook",
      "properties": {
        "runbook.daemonUrl": {
          "type": "string",
          "default": "ws://127.0.0.1:29381/ws",
          "description": "WebSocket URL for the Runbook daemon."
        }
      }
    },
    "commands": [
      {
        "command": "runbook.connect",
        "title": "Runbook: Connect to daemon"
      },
      {
        "command": "runbook.disconnect",
        "title": "Runbook: Disconnect from daemon"
      },
      {
        "command": "runbook.dispatchTest",
        "title": "Runbook: Dispatch test prompt"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "pretest": "npm run compile",
    "test": "node ./dist/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^2.5.2",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ws": "^8.17.0"
  }
}
